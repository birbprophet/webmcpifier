{
  "name": "webmcpifier",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "test": "vp run -r test",
    "dev": "vp run studio#dev",
    "dev:stack": "alchemy dev",
    "deploy": "alchemy deploy",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.74",
    "@cloudflare/workers-types": "5.20260826.1",
    "@effect/vitest": "4.0.0-rc.112",
    "@foldkit/vite-plugin": "0.19.0",
    "@types/node": "26.3.0",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.153.0",
    "happy-dom": "18.0.1",
    "parse5": "8.0.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.153.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.0"
}
